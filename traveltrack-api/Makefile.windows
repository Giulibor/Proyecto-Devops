

# ===========================
# TravelTrack API - Makefile (Windows/WSL2)
# ===========================
# Uso recomendado: ejecutar dentro de Ubuntu-WSL2 (Docker Desktop con integración WSL2).
# Si se usa Git Bash o PowerShell nativo, puede requerir MSYS_NO_PATHCONV=1 para que los bind mounts (-v) no rompan rutas.
# Este Makefile hereda todos los targets del Makefile base y agrega utilidades específicas para Windows/WSL2.

SHELL := /bin/bash

# Incluir Makefile base (macOS/Linux)
include Makefile

# -------- Detección simple de WSL2 --------
IS_WSL := $(shell uname -r | grep -i microsoft | wc -l)

# -------- Utilidades específicas Windows/WSL2 --------
.PHONY: win-help win-use-host-docker win-use-minikube-docker win-docker-mount-test win-doctor

win-help: ## Ayuda específica para Windows/WSL2
	@echo "=== Windows/WSL2 ==="
	@echo "Recomendado: ejecutar en Ubuntu-WSL2."
	@echo "Si usás Git Bash/PowerShell, seteá MSYS_NO_PATHCONV=1 antes de usar 'docker run -v'."
	@$(MAKE) help

win-use-host-docker: ## Cambia Docker CLI al daemon del host (Docker Desktop) con compatibilidad Windows
	@export MSYS_NO_PATHCONV=1; eval "$$(minikube docker-env -u)"; docker info 2>/dev/null | grep -i '^ name' || true

win-use-minikube-docker: ## Cambia Docker CLI al daemon de Minikube con compatibilidad Windows
	@export MSYS_NO_PATHCONV=1; eval "$$(minikube docker-env)"; docker info 2>/dev/null | grep -i '^ name' || true

win-docker-mount-test: ## Verifica que los bind mounts -v "$$PWD":/work funcionan correctamente
	@export MSYS_NO_PATHCONV=1; docker run --rm -v "$$PWD":/work -w /work alpine:3.20 sh -lc 'pwd; ls -la' || true

win-doctor: ## Diagnóstico rápido (Windows/WSL2) y delega en 'doctor'
	@echo "=== WIN DOCTOR ==="
	@echo "[WSL detect] $(IS_WSL) (1=WSL)"
	@echo "MSYS_NO_PATHCONV=$$MSYS_NO_PATHCONV"
	@$(MAKE) doctor