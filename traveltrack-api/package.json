{
  "name": "traveltrack-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "node -e \"require('fs').mkdirSync('reports',{recursive:true})\" && eslint \\\"src/**/*.{ts,tsx}\\\" -f stylish -o reports/eslint-report.txt --max-warnings=0",
    "semgrep": "node -e \"require('fs').mkdirSync('reports',{recursive:true})\" && semgrep --config ./.semgrep.yml --json > reports/semgrep-report.json",
    "audit": "node -e \"require('fs').mkdirSync('reports',{recursive:true})\" && npm audit --json > reports/npm-audit.txt || true"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.5.4",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.11.1",
    "eslint-plugin-security": "^3.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
