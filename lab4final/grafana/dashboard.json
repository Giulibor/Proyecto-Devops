{
  "title": "Lab4 Demo - B\u00e1sico",
  "panels": [
    {
      "type": "stat",
      "title": "Requests total",
      "targets": [
        {
          "expr": "lab4_requests_total"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Uptime (s)",
      "targets": [
        {
          "expr": "lab4_uptime_seconds"
        }
      ]
    },
    {
      "type": "graph",
      "title": "CPU per Pod",
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"lab4\",pod=~\"demo-lab4-demo-.*\"}[5m]))"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Memory per Pod",
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"lab4\",pod=~\"demo-lab4-demo-.*\"})"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}